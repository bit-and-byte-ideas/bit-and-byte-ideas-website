    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "^8.3.0",
    "@testing-library/dom": "^10.4.1",
